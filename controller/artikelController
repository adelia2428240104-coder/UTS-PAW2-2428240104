const {
    getAllArtikel,
    getPhotoById,
    getArtikelsByJenis,
    addArtikel,
    updateArtikel,
    deleteArtikel
} = require("../models/ArtikelModel");

const createError = (message, status) => {
    const error = new Error(message);
    error.status = status;
    return error;
};


const getAll = (req, res) => {
    const { KodeArtikel } = req.query;

    if (KodeArtikel) {
        return res.json({
            status: "success",
            data: getArtikelsByKodeArtikel(KodeArtikel)
        });
    }

    res.json({
        status: "success",
        data: getAllArtikels()
    });
};

const getById = (req, res, next) => {
    const id = parseInt(req.params.id);

    const Artikel = getArtikelById(id);

    if (!Artikel) {
        return next(createError("Artikel tidak ditemukan", 404));
    }

    res.json({
        status: "success",
        data: Artikel
    });
};


